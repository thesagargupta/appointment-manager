# Copy to `.env` (never commit the real file). Placeholder values only.

# --- Server ---
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (Database > Connect > Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/appointment_manager?retryWrites=true&w=majority
# Browser origin allowed by CORS (the URL users open). Dev: Vite on 5173. Prod: your public https URL.
CLIENT_ORIGIN=http://localhost:5173
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=change-me-generate-a-long-random-secret
APP_TIMEZONE=Asia/Kolkata
# Number of reverse proxies in front of the app (defaults: 1 in production, 0 otherwise).
# TRUST_PROXY=1
# Failed/total login attempts per IP per 15 minutes (default 10).
# LOGIN_RATE_LIMIT_MAX=10

# --- Administrator bootstrap (used only by `npm run admin:init`; remove from the environment afterwards) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars

# --- Client (build-time, exposed to the browser: never put secrets here) ---
# Leave VITE_API_URL unset when the API and SPA share an origin (default `/api`).
# VITE_API_URL=/api
VITE_APP_TIMEZONE=Asia/Kolkata
